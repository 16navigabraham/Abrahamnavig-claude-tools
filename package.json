{
  "name": "abrahamnavig-claude-tools",
  "version": "0.1.0",
  "description": "PDF tools for Claude, exposed as an MCP server and through a Claude API agent",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mcp": "tsx src/mcp/main.ts",
    "agent": "tsx src/agent/cli.ts",
    "serve": "tsx src/http/main.ts",
    "start": "node dist/http/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/16navigabraham/Abrahamnavig-claude-tools.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/16navigabraham/Abrahamnavig-claude-tools/issues"
  },
  "homepage": "https://github.com/16navigabraham/Abrahamnavig-claude-tools#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pdf-lib": "^1.17.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "bin": {
    "claude-tools-mcp": "dist/mcp/main.js"
  },
  "engines": {
    "node": ">=22.12"
  }
}
